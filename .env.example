# Copy to apps/api/.env for local development. Never commit real values.

# Token every client of the API must send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
# If it is unset or shorter than 32 characters, the API rejects every request.
API_SERVICE_TOKEN=

# Slack app credentials, from https://api.slack.com/apps for your app.
# Bot User OAuth Token (OAuth & Permissions page). Starts with xoxb-.
SLACK_BOT_TOKEN=
# Signing Secret (Basic Information page, App Credentials).
SLACK_SIGNING_SECRET=
# Until both are set, POST /slack/events answers 503 and the rest of the API keeps working.

# Supabase Postgres connection string, Transaction pooler (port 6543). In the Supabase
# dashboard: Connect, Transaction pooler. Contains the database password.
# Until it is set, features that need storage are switched off and the rest keeps working.
DATABASE_URL=

# Anthropic API key for the hippidy-bot workspace (platform.claude.com). Runs the agent.
ANTHROPIC_API_KEY=
# Signing secret of the webhook endpoint registered in the Anthropic Console (whsec_...).
# Without it, POST /v1/webhooks/agent rejects everything and only reconcile delivers replies.
ANTHROPIC_WEBHOOK_SIGNING_KEY=
# Optional: per-session spend cap in US cents (default 200, decision 55).
SESSION_BUDGET_CENTS=
