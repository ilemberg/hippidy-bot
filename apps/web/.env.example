# Copy to apps/web/.env.local for local development. Never commit real values.
# Until every variable is set and valid, sign-in is off and the page says so.

# The Slack app's credentials (https://api.slack.com/apps, Basic Information, App Credentials).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# The workspace's team id (T...). Only its members can sign in.
SLACK_WORKSPACE_ID=
# The bot token (xoxb-...), the same as the API's: asks Slack whether a person is a guest.
SLACK_BOT_TOKEN=

# The same value as the API's WEB_API_SECRET: signs the person tokens the API accepts.
# Generate with: openssl rand -hex 32
WEB_API_SECRET=
# Signs the session cookie. At least 32 characters, and different from WEB_API_SECRET.
WEB_SESSION_SECRET=

# The API's origin, and this app's. http is allowed only for localhost.
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001
