{
  "name": "@hippidy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "node --conditions=source --env-file-if-exists=.env --watch src/dev.ts",
    "build": "pnpm --filter @hippidy/contracts build",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hippidy/contracts": "workspace:*",
    "@slack/bolt": "^5.1.0",
    "@vercel/slack-bolt": "^1.7.5",
    "hono": "^4.13.19",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@hono/node-server": "^2.1.9"
  }
}
